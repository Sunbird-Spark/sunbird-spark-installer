# Ignoring common charts (both the extracted dir and the versioned .tgz
# archive helm dependency update actually produces, e.g. common-0.1.0.tgz)
**/charts/common
**/charts/common-*.tgz
# Ignoring test directories
**/kitchen

# Ignore built JARs for JanusGraph
scripts/janusgraph/*.jar

# Defense in depth: random_passwords modules write plaintext admin passwords
# here transiently before merging into global-values.yaml and deleting it --
# never let it land in git even if that delete step is skipped/fails.
patch-passwords.yaml
